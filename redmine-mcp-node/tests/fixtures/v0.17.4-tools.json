          },
          "status_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "狀態 id，可先用 list_issue_statuses 查詢。",
            "title": "Status Id"
          },
          "priority_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
